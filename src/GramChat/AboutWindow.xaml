<Window x:Class="GramChat.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About GramChat"
        Width="440" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <StackPanel Margin="24">
        <TextBlock Text="GramChat" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Foreground="#666666" Margin="0,2,0,14" />
        <TextBlock Text="The full Instagram experience — feed, profiles, messages, follow requests, private accounts and settings — with Reels and Explore kept out."
                   TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="Privacy" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Foreground="#444444"
                   Text="• Your Instagram password is never seen or stored — you sign in on Instagram's own secure page.&#10;• Saved logins are stored in an AES-256 encrypted database (SQLCipher) whose key is protected by Windows DPAPI.&#10;• Reels and Explore are blocked everywhere in the app; every other part of Instagram works normally.&#10;• Links that leave Instagram open in your system browser.&#10;• No analytics, no advertising SDKs, no data collection." />
        <Button Content="Close"
                Padding="32,6"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
