<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GramChat</RootNamespace>
    <AssemblyName>GramChat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0-beta5</Version>
    <Product>GramChat</Product>
    <AssemblyTitle>GramChat</AssemblyTitle>
    <Description>Instagram desktop client. Everything but Reels and Explore.</Description>
    <Authors>GramChat</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Encrypted session database (SQLCipher AES-256). DPAPI (ProtectedData)
         is part of the Windows runtime, no package needed. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

</Project>
