<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InstaChat</RootNamespace>
    <AssemblyName>InstaChat</AssemblyName>
    <Version>1.0.0-beta1</Version>
    <Product>InstaChat</Product>
    <AssemblyTitle>InstaChat</AssemblyTitle>
    <Description>Chat-only Instagram desktop client for Linux. Direct messages without Reels, Explore, or Feed.</Description>
    <Authors>InstaChat</Authors>
    <!-- This project only ever runs on Linux: silence the platform analyzer
         (WebKitGTK is Linux-only) and the GirCore obsolete-constructor warning
         (subclasses like MainWindow must call the native base ctor). -->
    <NoWarn>$(NoWarn);CA1416;GirCore1007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
    <PackageReference Include="GirCore.WebKit-6.0" Version="0.8.1" />
  </ItemGroup>

  <!-- The navigation policy and in-page hardening script are shared verbatim
       with the Windows client so both platforms enforce the same DM-only rules. -->
  <ItemGroup>
    <Compile Include="../InstaChat/Services/DmNavigationPolicy.cs" Link="Services/DmNavigationPolicy.cs" />
    <Compile Include="../InstaChat/Services/PageHardening.cs" Link="Services/PageHardening.cs" />
  </ItemGroup>

</Project>