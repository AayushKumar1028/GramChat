<Window x:Class="InstaChat.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About InstaChat"
        Width="440" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <StackPanel Margin="24">
        <TextBlock Text="InstaChat" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Foreground="#666666" Margin="0,2,0,14" />
        <TextBlock Text="Chat-only Instagram. Direct messages without Reels, Explore, Feed or Stories."
                   TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="Privacy" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Foreground="#444444"
                   Text="• Your Instagram password is never seen or stored — you sign in on Instagram's own secure page.&#10;• Session cookies are kept in an encrypted local browser profile (Windows DPAPI).&#10;• The app only loads the Direct Messaging experience; navigation to any other part of Instagram is blocked.&#10;• No analytics, no advertising SDKs, no data collection." />
        <Button Content="Close"
                Padding="32,6"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
