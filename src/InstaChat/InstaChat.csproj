<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InstaChat</RootNamespace>
    <AssemblyName>InstaChat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0-beta5</Version>
    <Product>InstaChat</Product>
    <AssemblyTitle>InstaChat</AssemblyTitle>
    <Description>Chat-only Instagram desktop client. Direct messages without Reels, Explore, or Feed.</Description>
    <Authors>InstaChat</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
